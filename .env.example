# Required in production
OPENROUTER_API_KEY=            # openrouter.ai -> Keys
AUTH_SECRET=                   # any random 32+ char string (openssl rand -hex 32)
NEXT_PUBLIC_SITE_URL=          # e.g. https://clawbackshield.netlify.app (Netlify also sets URL automatically)
# Email (Resend). Without it, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="ClawbackShield <hello@yourdomain.com>"   # domain must be verified in Resend
# Payments (Stripe test mode: sk_test_...). Without it, dev upgrades are mocked.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=         # whsec_... for endpoint /api/stripe/webhook (events: checkout.session.completed, customer.subscription.deleted)
STRIPE_PRICE_PACK=             # price_... one-time $19
STRIPE_PRICE_CAREGIVER=        # price_... recurring $49/month

# Optional owner test login and cron protection
DEMO_LOGIN_CODE=
CRON_SECRET=
OWNER_EMAIL=
